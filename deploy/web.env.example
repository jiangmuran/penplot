# /etc/penplot/web.env  (root:penplot 0640)
PENPLOT_HOST=0.0.0.0
PENPLOT_PORT=8080
PENPLOT_DATA_DIR=/var/lib/penplot
PENPLOT_FONT_DIR=/var/lib/penplot/fonts
PENPLOT_CACHE_DIR=/run/penplot
# /run is a small tmpfs shared with systemd and charged to this unit's memory: keep it modest
PENPLOT_CACHE_MB=64
# PENPLOT_STATIC_DIR=/opt/penplot/current/penplot/web/static
# overrides the active profile's connection.port (by-id is ambiguous with 2 CH340s: use by-path then)
# PENPLOT_SERIAL_PORT=/dev/serial/by-id/usb-1a86_USB_Serial-if00-port0
PENPLOT_TASK_WORKERS=2
PENPLOT_LOG_LEVEL=INFO
# never enable on the board: CORS allowlist, FakeGrbl, no setup code
PENPLOT_DEV=0
# optional HTTPS (self-signed); phones will warn
# PENPLOT_TLS_CERT=/etc/penplot/cert.pem
# PENPLOT_TLS_KEY=/etc/penplot/key.pem
